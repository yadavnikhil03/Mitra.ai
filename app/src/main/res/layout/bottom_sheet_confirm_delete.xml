<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="22dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_all_title"
        android:textSize="22sp"
        android:textColor="@color/text_primary"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:layout_marginBottom="8dp" />

    <!-- Warning message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_all_confirm"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginBottom="24dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Destructive Delete Button -->
        <Button
            android:id="@+id/btnConfirmDelete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/delete_all_chats"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rose_button"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp" />

        <!-- Cancel Button -->
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:background="@drawable/bg_suggestion_card"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
