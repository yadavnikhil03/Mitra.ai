<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/containerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:paddingTop="12dp"
        android:paddingBottom="36dp">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="@drawable/drag_handle"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_title"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="14dp" />

        <!-- Body Paragraph 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_body_1"
            android:textColor="#F5ECE4"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="12dp" />

        <!-- Body Paragraph 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_body_2"
            android:textColor="#F5ECE4"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="12dp" />

        <!-- Body Paragraph 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_body_3"
            android:textColor="#F5ECE4"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="16dp" />

        <!-- Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_disclaimer"
            android:textColor="#B79E95"
            android:textSize="12.5sp"
            android:lineSpacingMultiplier="1.4"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="22dp" />

        <!-- Primary CTA: Okay / Understood button -->
        <Button
            android:id="@+id/btnOkay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/okay"
            android:textColor="#120809"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_cta_button"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="10dp"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <!-- Action link: Suggest Something / Feedback -->
        <TextView
            android:id="@+id/btnFeedback"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="@string/suggest_something"
            android:textColor="#F5ECE4"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_suggestion_card"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Action link: Delete All Chats -->
        <TextView
            android:id="@+id/btnDeleteAllChats"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="@string/delete_all_chats"
            android:textColor="#B79E95"
            android:textSize="14sp"
            android:background="@drawable/bg_suggestion_card"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Action link: Logout -->
        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="@string/log_out"
            android:textColor="#E89BA8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_suggestion_card"
            android:layout_marginHorizontal="22dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
