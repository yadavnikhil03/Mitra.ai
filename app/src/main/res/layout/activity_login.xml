<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_edge"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingHorizontal="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/authCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_auth_card"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp"
            android:maxWidth="440dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="48dp"
            android:elevation="2dp">

            <!-- Brand Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp">

                <View
                    android:id="@+id/brandDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/ic_mitra_dot"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="26sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp" />

            <!-- Welcome Copy -->
            <TextView
                android:id="@+id/tvAuthWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_welcome"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.5"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvAuthError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/rose"
                android:background="@drawable/bg_error_banner"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp"
                android:lineSpacingMultiplier="1.4"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Email Field -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_auth_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:hint="@string/email_hint"
                android:textColorHint="@color/muted"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:layout_marginBottom="12dp" />

            <!-- Password Field -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_auth_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:hint="@string/password_hint"
                android:textColorHint="@color/muted"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:layout_marginBottom="20dp" />

            <!-- Submit CTA -->
            <Button
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/sign_in"
                android:background="@drawable/bg_cta_button"
                android:textColor="#141210"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:layout_marginBottom="6dp" />

            <!-- Auth links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/btnAuthToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/new_here"
                    android:textColor="@color/ember_core"
                    android:textSize="13.5sp"
                    android:gravity="start|center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password"
                    android:textColor="@color/muted"
                    android:textSize="13.5sp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
