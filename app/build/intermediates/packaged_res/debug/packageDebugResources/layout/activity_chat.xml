<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/night_edge">

        <!-- Particle canvas background -->
        <com.mitra.app.ui.chat.ParticleView
            android:id="@+id/particleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Ambient glow orb -->
        <View
            android:id="@+id/glowOrb"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="@drawable/glow_orb"
            android:alpha="0.7"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.14" />

        <!-- Gradient overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_overlay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:importantForAccessibility="no" />

        <!-- Header bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingHorizontal="12dp"
            android:background="@color/night_edge"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Chat list / Left Drawer toggle button -->
            <ImageButton
                android:id="@+id/btnChatList"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_chats"
                android:padding="10dp"
                android:contentDescription="@string/cd_chats"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Brand -->
            <LinearLayout
                android:id="@+id/brandContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnChatList"
                app:layout_constraintEnd_toStartOf="@id/headerRightActions">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center">

                    <View
                        android:id="@+id/brandDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/ic_mitra_dot"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/brandName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="21sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="serif"
                        android:textStyle="italic"
                        android:letterSpacing="-0.01" />
                </LinearLayout>

                <TextView
                    android:id="@+id/brandTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textSize="11sp"
                    android:textColor="@color/faint"
                    android:letterSpacing="0.02"
                    android:layout_gravity="center" />
            </LinearLayout>

            <!-- Header Right Actions (TTS + New Chat + Info) -->
            <LinearLayout
                android:id="@+id/headerRightActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Speaker TTS button -->
                <ImageButton
                    android:id="@+id/btnTts"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_btn"
                    android:src="@drawable/ic_volume_off"
                    android:padding="10dp"
                    android:contentDescription="@string/cd_tts"
                    android:layout_marginEnd="8dp" />

                <!-- New Chat button -->
                <ImageButton
                    android:id="@+id/btnHeaderNewChat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_btn"
                    android:src="@drawable/ic_plus"
                    android:padding="10dp"
                    android:contentDescription="@string/new_chat"
                    android:layout_marginEnd="8dp" />

                <!-- Info button -->
                <ImageButton
                    android:id="@+id/btnInfo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_btn"
                    android:src="@drawable/ic_info"
                    android:padding="10dp"
                    android:contentDescription="@string/cd_info" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Header Divider Line -->
        <View
            android:id="@+id/headerDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <!-- Incognito banner -->
        <TextView
            android:id="@+id/incognitoBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incognito_active_banner"
            android:textSize="12.5sp"
            android:textColor="#C4B5FD"
            android:paddingHorizontal="16dp"
            android:paddingVertical="7dp"
            android:background="@drawable/bg_incognito_banner"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:elevation="9dp"
            app:layout_constraintTop_toBottomOf="@id/headerDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Messages RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/headerDivider"
            app:layout_constraintBottom_toTopOf="@id/suggestionContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Suggestion Chips Bar -->
        <HorizontalScrollView
            android:id="@+id/suggestionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingHorizontal="14dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/composerContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSuggestion1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suggestion_1_title"
                    android:textColor="@color/ember_core"
                    android:textSize="13sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/bg_suggestion_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipSuggestion2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suggestion_2_title"
                    android:textColor="@color/ember_core"
                    android:textSize="13sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/bg_suggestion_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipSuggestion3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suggestion_3_title"
                    android:textColor="@color/ember_core"
                    android:textSize="13sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/bg_suggestion_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipSuggestion4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suggestion_4_title"
                    android:textColor="@color/ember_core"
                    android:textSize="13sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/bg_suggestion_card"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Composer bar -->
        <LinearLayout
            android:id="@+id/composerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@color/night_edge"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Text input -->
            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_composer_input"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:hint="@string/type_anything"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textColorHint="@color/faint"
                android:inputType="textMultiLine|textCapSentences"
                android:autofillHints=""
                android:maxLines="5"
                android:minLines="1"
                android:gravity="top|start"
                android:cursorVisible="true"
                android:textCursorDrawable="@drawable/cursor_ember"
                android:imeOptions="actionSend"
                android:layout_marginEnd="10dp" />

            <!-- Mic button -->
            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_mic"
                android:padding="12dp"
                android:contentDescription="@string/cd_mic"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <!-- Send button -->
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_send_btn"
                android:src="@drawable/ic_send"
                android:padding="12dp"
                android:contentDescription="@string/cd_send"
                android:elevation="4dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LEFT SLIDING NAVIGATION DRAWER -->
    <LinearLayout
        android:id="@+id/leftDrawerContainer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/night_edge"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Drawer Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/your_chats"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:fontFamily="serif"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnDrawerNewChat"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/new_chat"
                android:textColor="@color/night_edge"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_cta_button"
                android:layout_marginEnd="8dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnDrawerIncognito"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/incognito"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:background="@drawable/bg_ghost_chip"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line"
            android:layout_marginBottom="12dp" />

        <!-- Chat History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDrawerChats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
