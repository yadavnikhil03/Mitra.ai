<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/drag_handle"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_title"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_body_1"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.6"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_body_2"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.6"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_body_3"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.6"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="16dp" />

        <!-- Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_disclaimer"
            android:textColor="@color/faint"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.5"
            android:paddingHorizontal="22dp"
            android:layout_marginBottom="24dp" />

        <!-- Okay button -->
        <Button
            android:id="@+id/btnOkay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/okay"
            android:textColor="@color/night_edge"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_cta_button"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="12dp"
            android:stateListAnimator="@null" />

        <!-- Action links -->
        <TextView
            android:id="@+id/btnFeedback"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/suggest_something"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:background="@drawable/bg_suggestion_card"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnDeleteAllChats"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/delete_all_chats"
            android:textColor="@color/muted"
            android:textSize="13.5sp"
            android:background="@drawable/bg_suggestion_card"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/log_out"
            android:textColor="@color/rose"
            android:textSize="13.5sp"
            android:background="@drawable/bg_suggestion_card"
            android:layout_marginHorizontal="22dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
